# shellcheck shell=bash disable=SC2034  # variables are consumed by the sourcing workflow
# Pinned integration-test devices (06 §4, Phase 3 Sprint 3.4).
#
# Read by .gitea/workflows/integration.yml. Locally:
#   set -a; . tools/ci/sim.env; set +a
#
# Rules: KEY=value, no quotes, no spaces, no `;`. The workflow sources the
# file and also appends every KEY=value line verbatim to $GITHUB_ENV, so a
# value must mean the same thing to both. Bump deliberately (a new
# simulator runtime can shift layout, so goldens and flows may need a look).
# Pinned to what the runner (Mac mini, Xcode 26.6) has installed on
# 2026-09-28: `xcrun simctl list runtimes`, `sdkmanager --list_installed`.

# Informational: the Xcode the pins were chosen with (a mismatch warns).
EXPECTED_XCODE=26.6

# iOS simulator (created on demand, erased before every run).
IOS_SIM_NAME=taro-ci-iphone-16
IOS_SIM_DEVICE_TYPE=com.apple.CoreSimulator.SimDeviceType.iPhone-16
IOS_SIM_RUNTIME=com.apple.CoreSimulator.SimRuntime.iOS-26-5

# Android emulator (AVD created on demand, wiped on every boot). The image
# path is system-images;android-${ANDROID_API_LEVEL};${ANDROID_IMAGE_TAG};${ANDROID_ABI}.
ANDROID_AVD_NAME=taro-ci-pixel-api36
ANDROID_AVD_DEVICE=pixel_6
ANDROID_API_LEVEL=36
ANDROID_IMAGE_TAG=google_apis_playstore
ANDROID_ABI=arm64-v8a
# A fixed console port keeps CI off the developer's default emulator-5554.
ANDROID_EMULATOR_PORT=5580
