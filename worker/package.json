{
  "name": "taro-api",
  "version": "0.0.0",
  "private": true,
  "description": "Taro API \u2014 Cloudflare Worker (Hono on workerd)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --env dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "types": "wrangler types",
    "types:check": "wrangler types --check",
    "deploy:dry": "wrangler deploy --dry-run --outdir dist --env staging",
    "config:schema": "node scripts/run.mjs export-config-schema",
    "config:schema:check": "node scripts/run.mjs export-config-schema --check",
    "config:push": "node scripts/run.mjs config-push",
    "openapi": "node scripts/run.mjs export-openapi",
    "openapi:check": "node scripts/run.mjs export-openapi --check",
    "contract:update": "vitest run test/contract --update",
    "smoke": "node scripts/run.mjs smoke",
    "gen-keys": "node scripts/run.mjs gen-keys",
    "credits-transfer": "node scripts/run.mjs credits-transfer",
    "ledger-adjust": "node scripts/run.mjs ledger-adjust",
    "metrics": "node scripts/run.mjs metrics",
    "prompt:render": "node scripts/run.mjs render-prompt",
    "eval:offline": "node scripts/run.mjs eval-offline",
    "eval": "node scripts/run.mjs eval",
    "eval:safety": "node scripts/run.mjs eval-safety",
    "safety:lexicons": "node scripts/run.mjs safety-lexicons",
    "safety:lexicons:check": "node scripts/run.mjs safety-lexicons --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@hono/zod-openapi": "1.6.3",
    "@peculiar/x509": "2.1.0",
    "cbor-x": "1.6.6",
    "hono": "4.13.9",
    "jose": "6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "@vitest/coverage-istanbul": "4.1.11",
    "esbuild": "0.28.1",
    "eslint": "10.11.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "4.1.11",
    "wrangler": "4.142.0"
  }
}
