{
  "name": "taro-api",
  "version": "0.0.0",
  "private": true,
  "description": "Taro API — Cloudflare Worker (Hono on workerd)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --env dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "types": "wrangler types",
    "types:check": "wrangler types --check",
    "deploy:dry": "wrangler deploy --dry-run --outdir dist --env staging"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@hono/zod-openapi": "1.6.3",
    "@peculiar/x509": "2.1.0",
    "cbor-x": "1.6.6",
    "hono": "4.13.9",
    "jose": "6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "@vitest/coverage-istanbul": "4.1.11",
    "eslint": "10.11.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "4.1.11",
    "wrangler": "4.142.0"
  }
}
