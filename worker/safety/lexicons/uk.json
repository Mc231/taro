    },
    {
      "id": "ho.lesson",
      "category": "harm_to_others",
      "severity": "high",
      "patterns": ["урок", "не переживе"]
    },
    {
      "id": "ho.maim",
      "category": "harm_to_others",
      "severity": "high",
      "patterns": ["скалічу|скалічити"]
    },
    {
      "id": "ho.hint",
      "category": "harm_to_others",
      "severity": "hint",
      "patterns": ["помст\\p{L}*|зробити боляче|побити|напасти"]
    },
    {
      "id": "sm.sexual_minor",
      "category": "sexual_minors",
      "severity": "high",
      "patterns": [
        "секс\\p{L}*|еротичн\\p{L}*|відверті фото|оголен\\p{L}*|близькост\\p{L}*|коханц\\p{L}*|пересплю|переспати|чуттєв\\p{L}*|порно\\p{L}*|романтичну ніч",
        "(?<![\\p{N}])(?:[1-9]|1[0-7])-?річн\\p{L}*|неповнолітн\\p{L}*|семикласник\\p{L}*|школярк\\p{L}*|дорослим і дитиною|(?:їй|йому) (?:[1-9]|1[0-7])(?![\\p{N}])"
      ],
      "unless": ["(?:моя|наша) донька|(?:мій|наш) син|(?:мої|наші) діти"]
    },
    {
      "id": "he.hint",
      "category": "health",
      "severity": "hint",
      "patterns": [
        "рак|пухлин\\p{L}*|діагноз\\p{L}*|хвороб\\p{L}*|операці\\p{L}*|біопсі\\p{L}*|аналіз\\p{L}*|хіміотерапі\\p{L}*|лік\\p{L}*|антидепресант\\p{L}*|інсулін\\p{L}*|симптом\\p{L}*"
