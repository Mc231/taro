      ]
    },
    {
      "id": "ga.hint",
      "category": "gambling",
      "severity": "hint",
      "patterns": [
        "loteria|apuesta\\p{L}*|apostar|casino|jackpot|poker|ruleta|blackjack|numeros ganadores"
      ]
