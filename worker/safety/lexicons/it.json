      "oxycodon*",
      "morphin*",
      "metformin*",
      "prozac",
      "xanax",
      "valium",
      "ozempic"
    ],
    "nonClaimSpans": ["precisamente", "precisare", "domand[ae] precis[ae]"]
  }
}
