        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"purchase_outbox\" (\"txn_key\" TEXT NOT NULL PRIMARY KEY, \"product_id\" TEXT NOT NULL, \"platform\" TEXT NOT NULL CHECK (platform IN ('ios', 'android')), \"transaction_id\" TEXT, \"verification_data\" TEXT, \"order_id\" TEXT, \"idempotency_key\" TEXT NOT NULL, \"status\" TEXT NOT NULL CHECK (status IN ('awaitingVerification', 'granted', 'finished', 'rejected')), \"attempts\" INTEGER NOT NULL DEFAULT 0, \"last_error\" TEXT, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
