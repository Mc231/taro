        "name": "readings_fts_insert",
        "sql": "CREATE TRIGGER readings_fts_insert AFTER INSERT ON readings BEGIN\n  INSERT INTO journal_search_refs (kind, ref) VALUES ('reading', new.id);\n  INSERT INTO journal_fts (rowid, question, note) VALUES (\n    (SELECT fts_rowid FROM journal_search_refs WHERE kind = 'reading' AND ref = new.id),\n    new.question,\n    new.note\n  );\nEND;"
      }
    },
