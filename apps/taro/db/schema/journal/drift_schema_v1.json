        "name": "readings_fts_update",
        "sql": "CREATE TRIGGER readings_fts_update AFTER UPDATE OF question, note ON readings BEGIN\n  UPDATE journal_fts SET question = new.question, note = new.note\n    WHERE rowid = (SELECT fts_rowid FROM journal_search_refs WHERE kind = 'reading' AND ref = old.id);\nEND;"
      }
    },
