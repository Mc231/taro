<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links on https://taro.vshyrochuk.com/app/* (02 §8.2, RC17).
	     The apple-app-site-association file is hosted in Phase 20. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:taro.vshyrochuk.com</string>
	</array>
	<!-- App Attest (03 §3.3, AR9), Debug-* configurations. Release-* and
	     Profile-* sign with Runner.entitlements ("production"). Keep both
	     files in sync apart from this value. -->
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>development</string>
</dict>
</plist>
