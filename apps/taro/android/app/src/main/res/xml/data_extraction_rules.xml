<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+) backup and device-transfer rules. taro_journal.db may be
     backed up; device-bound state and secure storage never are. Keep in sync with
     full_backup_content.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <!-- flutter_secure_storage (02 §6.2): install id, install secret, session token,
             purchase binding. Keystore keys never leave the device, so a restored copy
             could not be decrypted anyway. -->
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:FlutterSecureStorage.xml" />
        <!-- taro_device.db (02 §6.1, RC75): outbox, caches, entitlements, consent.
             drift_flutter names files <name>.sqlite by default, so both names are listed;
             path_provider documents dir = app_flutter/ on Android. -->
        <exclude domain="file" path="app_flutter/taro_device.db" />
        <exclude domain="file" path="app_flutter/taro_device.db-wal" />
        <exclude domain="file" path="app_flutter/taro_device.db-shm" />
        <exclude domain="file" path="app_flutter/taro_device.db-journal" />
        <exclude domain="file" path="app_flutter/taro_device.sqlite" />
        <exclude domain="file" path="app_flutter/taro_device.sqlite-wal" />
        <exclude domain="file" path="app_flutter/taro_device.sqlite-shm" />
        <exclude domain="file" path="app_flutter/taro_device.sqlite-journal" />
        <exclude domain="database" path="taro_device.db" />
        <exclude domain="database" path="taro_device.db-wal" />
        <exclude domain="database" path="taro_device.db-shm" />
        <exclude domain="database" path="taro_device.db-journal" />
        <exclude domain="database" path="taro_device.sqlite" />
        <exclude domain="database" path="taro_device.sqlite-wal" />
        <exclude domain="database" path="taro_device.sqlite-shm" />
        <exclude domain="database" path="taro_device.sqlite-journal" />
    </cloud-backup>
    <device-transfer>
        <!-- flutter_secure_storage (02 §6.2): install id, install secret, session token,
             purchase binding. Keystore keys never leave the device, so a restored copy
             could not be decrypted anyway. -->
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:FlutterSecureStorage.xml" />
        <!-- taro_device.db (02 §6.1, RC75): outbox, caches, entitlements, consent.
             drift_flutter names files <name>.sqlite by default, so both names are listed;
             path_provider documents dir = app_flutter/ on Android. -->
        <exclude domain="file" path="app_flutter/taro_device.db" />
        <exclude domain="file" path="app_flutter/taro_device.db-wal" />
        <exclude domain="file" path="app_flutter/taro_device.db-shm" />
        <exclude domain="file" path="app_flutter/taro_device.db-journal" />
        <exclude domain="file" path="app_flutter/taro_device.sqlite" />
        <exclude domain="file" path="app_flutter/taro_device.sqlite-wal" />
        <exclude domain="file" path="app_flutter/taro_device.sqlite-shm" />
        <exclude domain="file" path="app_flutter/taro_device.sqlite-journal" />
        <exclude domain="database" path="taro_device.db" />
        <exclude domain="database" path="taro_device.db-wal" />
        <exclude domain="database" path="taro_device.db-shm" />
        <exclude domain="database" path="taro_device.db-journal" />
        <exclude domain="database" path="taro_device.sqlite" />
        <exclude domain="database" path="taro_device.sqlite-wal" />
        <exclude domain="database" path="taro_device.sqlite-shm" />
        <exclude domain="database" path="taro_device.sqlite-journal" />
    </device-transfer>
</data-extraction-rules>
