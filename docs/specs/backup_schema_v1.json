{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taro.vshyrochuk.com/schemas/backup_schema_v1.json",
  "title": "Taro backup file, schema version 1 (frozen, RC70)",
  "description": "Canonical source: docs/specs/backup_schema_v1.json. A byte-identical copy lives at packages/taro_data/lib/src/backup/backup_schema_v1.json (checked by a test). checksum = lowercase hex SHA-256 over the RFC 8785 (JCS) canonical JSON of `data`. Never contains credits, entitlements, install ID, install secret, consent states, outbox or sync state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "exportedAt", "appVersion", "data", "checksum"],
  "properties": {
    "format": { "const": "taro.backup" },
    "schemaVersion": { "const": 1 },
    "exportedAt": { "$ref": "#/$defs/instant" },
    "appVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+\\+\\d+$", "maxLength": 32 },
    "checksum": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["settings", "readings", "dailyCards"],
      "properties": {
        "settings": { "$ref": "#/$defs/settings" },
        "readings": { "type": "array", "maxItems": 50000, "items": { "$ref": "#/$defs/reading" } },
        "dailyCards": { "type": "array", "maxItems": 50000, "items": { "$ref": "#/$defs/dailyCard" } }
      }
    }
  },
  "$defs": {
    "instant": { "type": "string", "format": "date-time", "pattern": "Z$", "maxLength": 40 },
    "localDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "locale": { "enum": ["en", "ar", "de", "es", "fr", "it", "ja", "ko", "nl", "pt", "tr", "uk"] },
    "cardId": { "type": "string", "pattern": "^(major_(0\\d|1\\d|2[01])|(wands|cups|swords|pentacles)_(0[1-9]|1[0-4]))$" },
    "spreadId": { "enum": ["single", "three_ppf", "three_sao", "relationship", "two_paths", "celtic_cross"] },
    "note": { "type": ["string", "null"], "maxLength": 5000 },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theme", "reversalsEnabled", "hapticsEnabled", "reminder", "localeOverride"],
      "properties": {
        "theme": { "enum": ["system", "light", "dark"] },
        "reversalsEnabled": { "type": "boolean" },
        "hapticsEnabled": { "type": "boolean" },
        "reminder": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "time"],
          "properties": {
            "enabled": { "type": "boolean" },
            "time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" }
          }
        },
        "localeOverride": { "anyOf": [{ "$ref": "#/$defs/locale" }, { "type": "null" }] }
      }
    },
    "drawnCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positionId", "cardId", "reversed"],
      "properties": {
        "positionId": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
        "cardId": { "$ref": "#/$defs/cardId" },
        "reversed": { "type": "boolean" }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary", "positions", "synthesis", "reflectionPrompts"],
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "summary": { "type": "string", "maxLength": 2000 },
        "positions": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["positionId", "text"],
            "properties": {
              "positionId": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
              "text": { "type": "string", "maxLength": 3000 }
            }
          }
        },
        "synthesis": { "type": "string", "maxLength": 4000 },
        "reflectionPrompts": { "type": "array", "maxItems": 3, "items": { "type": "string", "maxLength": 300 } }
      }
    },
    "reading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "createdAt", "updatedAt", "localDate", "spreadId", "question", "cards", "status", "content", "contentLocale", "promptVersion", "note", "favourite", "rating", "ratingReason"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "createdAt": { "$ref": "#/$defs/instant" },
        "updatedAt": { "$ref": "#/$defs/instant" },
        "localDate": { "$ref": "#/$defs/localDate" },
        "spreadId": { "$ref": "#/$defs/spreadId" },
        "question": { "type": ["string", "null"], "maxLength": 1200 },
        "cards": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/drawnCard" } },
        "status": { "enum": ["complete", "refused", "classic"] },
        "content": { "anyOf": [{ "$ref": "#/$defs/content" }, { "type": "null" }] },
        "contentLocale": { "$ref": "#/$defs/locale" },
        "promptVersion": { "type": ["string", "null"], "maxLength": 16 },
        "note": { "$ref": "#/$defs/note" },
        "favourite": { "type": "boolean" },
        "rating": { "enum": ["up", "down", null] },
        "ratingReason": { "enum": ["too_generic", "mismatch", "tone", "other", null] }
      }
    },
    "dailyCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localDate", "cardId", "reversed", "drawnAt", "createdAt", "updatedAt", "note", "favourite"],
      "properties": {
        "localDate": { "$ref": "#/$defs/localDate" },
        "cardId": { "$ref": "#/$defs/cardId" },
        "reversed": { "type": "boolean" },
        "drawnAt": { "$ref": "#/$defs/instant" },
        "createdAt": { "$ref": "#/$defs/instant" },
        "updatedAt": { "$ref": "#/$defs/instant" },
        "note": { "$ref": "#/$defs/note" },
        "favourite": { "type": "boolean" }
      }
    }
  }
}
